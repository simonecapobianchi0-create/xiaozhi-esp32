{
    "target": "esp32s3",
    "builds": [
        {
            "name": "otto-robot",
            "sdkconfig_append": [
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV2640_DVP_YUV422_240X240_25FPS=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"chow you go;chow who go;chow ooh go\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Ciao Ugo\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_SR_MN_EN_MULTINET7_QUANT=y",
                "CONFIG_SR_MN_CN_NONE=y"
            ]
        }
    ]
}
